# Deterministic demo mode needs no credentials.
# These values are only needed for optional OpenAI-compatible enrichment.
OT_AGENT_LLM_BASE_URL=https://api.openai.com/v1
OT_AGENT_LLM_MODEL=
OT_AGENT_LLM_API_KEY=
# Exact, comma-separated HTTPS hostnames. The default is api.openai.com.
OT_AGENT_LLM_ALLOWED_HOSTS=api.openai.com
OT_AGENT_AUDIT_PATH=.local/audit.jsonl
